APIFY_TOKEN=
# Apify actors (override if you prefer others)
IG_ACTOR=apify/instagram-profile-scraper
LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper

# Any OpenAI-compatible endpoint. Groq by default; Kaggle Ollama: https://<tunnel>/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# low|medium|high for reasoning models like gpt-oss; leave empty for Ollama
LLM_REASONING_EFFORT=low
# Optional comma-separated pool, rotated per call to spread per-model rate limits
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional second OpenAI-compatible host (e.g. self-hosted Ollama) added to the pool
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODELS=
